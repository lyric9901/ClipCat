# Maintainer: noxygalaxy <noxycraftyt@gmail.com>
pkgname=clipcat
pkgver=${CLIPCAT_VERSION:-${CONCAT_VERSION:?CLIPCAT_VERSION must be set}}
pkgrel=1
pkgdesc="Free and open source video editor"
arch=('x86_64' 'aarch64')
url="https://github.com/lyric9901/ClipCat"
license=('AGPL-3.0-or-later')
depends=('glibc' 'gtk3' 'fontconfig' 'freetype2' 'libxkbcommon' 'mesa' 'alsa-lib')
options=('!strip' '!debug')
source=()

stage=${CLIPCAT_STAGE:-${CONCAT_STAGE:?CLIPCAT_STAGE must point at the staged folder}}

package() {
  install -Dm755 "$stage/clipcat" "$pkgdir/opt/clipcat/clipcat"
  install -d "$pkgdir/opt/clipcat/lib"
  cp -a "$stage"/lib/. "$pkgdir/opt/clipcat/lib/"

  install -d "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec /opt/clipcat/clipcat "$@"\n' > "$pkgdir/usr/bin/clipcat"
  chmod 755 "$pkgdir/usr/bin/clipcat"
  install -Dm644 "$stage/clipcat.desktop" "$pkgdir/usr/share/applications/clipcat.desktop"
  sed -i 's|^Exec=clipcat|Exec=/opt/clipcat/clipcat %U|' "$pkgdir/usr/share/applications/clipcat.desktop"
  install -Dm644 "$stage/clipcat.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/clipcat.png"

  install -Dm644 "$stage/LICENSE" "$pkgdir/usr/share/licenses/clipcat/LICENSE"
  install -Dm644 "$stage/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/clipcat/THIRD_PARTY_NOTICES.md"
}
